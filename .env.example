# ==============================================================================
# Telegram Video Subscription Bot - Environment Template
# ==============================================================================

# Database (Neon / Postgres)
DATABASE_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# Telegram Bot Credentials
BOT_TOKEN="your_telegram_bot_token_from_botfather"
ADMIN_TELEGRAM_IDS="your_telegram_user_id"
SUPPORT_USERNAME="support_username"

# Telegram Webhook (Only required if running bot in webhook mode instead of polling)
# TELEGRAM_WEBHOOK_SECRET="random_secure_secret"
# WEBHOOK_URL="https://your-domain.com/api/bot/webhook"

# Razorpay Payment Gateway (Test Mode for development)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Internal Security Secrets
JWT_SECRET="generate_a_random_jwt_secret"
SETUP_SECRET="generate_a_random_setup_secret"
CRON_SECRET="generate_a_random_cron_secret"

# Public App Base URL (Used for payment callback redirects and webhooks)
# For local testing: tunnel URL (e.g., https://xxxx.ngrok-free.app or http://localhost:3000)
# For production: your live domain (e.g., https://bot.yourdomain.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
